# Copy to .env and fill in. Names only here: real values (they contain API keys) go in .env.

# One RPC URL per chain: RPC_URL_<NAME>. `--chain <name>` selects one (default: ethereum).
RPC_URL_ETHEREUM=
RPC_URL_BASE=

# Etherscan V2 API key (one key works across chains).
ETHERSCAN_API_KEY=

# Postgres cache, e.g. postgresql://user@localhost:5432/contract_analyzer
DATABASE_URL=
